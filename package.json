{
  "name": "erp-finance",
  "version": "1.0.0",
  "description": "ERP Finance financial operations webapp",
  "scripts": {
    "dev": "concurrently -k -n api,vite -c cyan,green \"npm run dev:api\" \"vite --host 127.0.0.1\"",
    "dev:api": "npm run build:server && node dist-server/primavera-api.js",
    "dev:vite": "vite --host 127.0.0.1",
    "start": "node dist-server/primavera-api.js",
    "seed:demo": "npm run build:server && node dist-server/db/build-demo-db.js",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:static": "tsc -b && vite build --mode static && node dist-server/db/generate-static-snapshots.js",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:node": "npm run build:server && node --test --test-force-exit server/backends/demo.test.mjs server/__tests__/primavera-api.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run test:node"
  },
  "keywords": [],
  "author": "Luis Baptista",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright": "^1.60.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.0",
    "ts-jest": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
