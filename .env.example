# Every variable below is read by the code. Copy to .env and adjust.

# ============ FRONTEND ============
# Set by `npm run build:static` (see package.json), not usually by hand. When
# "true", src/lib/api.ts reads pre-generated JSON snapshots from dist/api/
# instead of calling a live backend — this is what the GitHub Pages demo runs.
# VITE_STATIC=true

# ============ BACKEND ============
MEG_FINANCE_API_PORT=5000

# Bind address. Defaults to 127.0.0.1 so the dev API is not exposed on the
# network. Containers must set 0.0.0.0 to be reachable.
MEG_FINANCE_API_HOST=127.0.0.1

# "demo" reads the bundled SQLite database; "sqlserver" queries PRIMAVERA
# through the sqlcmd CLI.
PRIMAVERA_MODE=demo

NODE_ENV=development

# When set, the API also serves the built frontend from this directory with an
# SPA fallback, so a single process serves the whole app. Left unset in
# development, where Vite serves the frontend.
# STATIC_DIR=dist

# ============ DEMO BACKEND (PRIMAVERA_MODE=demo) ============
# Overrides the bundled SQLite file. Defaults to server/db/erp-finance-demo.sqlite
# resolved from the project root.
# DEMO_DB_PATH=

# ============ SQL SERVER BACKEND (PRIMAVERA_MODE=sqlserver) ============
# Queries run through the `sqlcmd` CLI, which must be on PATH and already
# authenticated (trusted connection).
PRIMAVERA_SQL_SERVER=localhost
PRIMAVERA_SQL_DATABASE=PRIDEMO

# ============ SECURITY ============
# Comma-separated CORS allowlist. Requests from other origins get no CORS
# headers back.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ AI WORKSPACE (optional) ============
# Without a key the AI pages show a notice instead of failing.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
